{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/kmephis-ai/VPS-Control-PNCC/.pncc-dev/schemas/durable-autonomous-continuation-session-checkpoint.schema.json",
  "title": "PNCC Durable Autonomous Continuation Session Checkpoint",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "role",
    "checkpoint_state",
    "checkpoint_id",
    "repository",
    "default_branch",
    "recorded_main_sha",
    "selected_work_unit",
    "provider_state",
    "execution_state",
    "last_completed_steady_state_iteration",
    "transaction_boundary",
    "persisted_decisions",
    "checkpoint_is_mutation_authority",
    "checkpoint_cas_tokens_reusable",
    "checkpoint_ci_success_reusable",
    "checkpoint_admission_reusable",
    "contains_private_runtime_payload",
    "contains_credentials",
    "contains_host_identifiers",
    "contains_secret_transport_data"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "role": {"const": "DURABLE_AUTONOMOUS_CONTINUATION_SESSION_CHECKPOINT"},
    "checkpoint_state": {"const": "PERSISTED_HINT_ONLY"},
    "checkpoint_id": {"type": "string", "pattern": "^PNCC-CONTINUATION-CHECKPOINT-[A-Za-z0-9._-]+$", "minLength": 32, "maxLength": 160},
    "repository": {"const": "kmephis-ai/VPS-Control-PNCC"},
    "default_branch": {"const": "main"},
    "recorded_main_sha": {"$ref": "#/$defs/sha40"},
    "selected_work_unit": {
      "oneOf": [
        {"type": "null"},
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["work_unit_id", "issue_number", "base_sha", "runtime_required", "provider_open"],
          "properties": {
            "work_unit_id": {"type": "string", "pattern": "^PIPE-WU-[0-9]+$"},
            "issue_number": {"type": "integer", "minimum": 1},
            "base_sha": {"$ref": "#/$defs/sha40"},
            "runtime_required": {"type": "boolean"},
            "provider_open": {"type": "boolean"}
          }
        }
      ]
    },
    "provider_state": {
      "type": "object",
      "additionalProperties": false,
      "required": ["state_branch_present", "state_branch_head_sha", "registry_blob_sha", "registry_generation"],
      "properties": {
        "state_branch_present": {"type": "boolean"},
        "state_branch_head_sha": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/sha40"}]},
        "registry_blob_sha": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/sha40"}]},
        "registry_generation": {"oneOf": [{"type": "null"}, {"type": "integer", "minimum": 0}]}
      }
    },
    "execution_state": {
      "type": "object",
      "additionalProperties": false,
      "required": ["lease", "branch", "pull_request", "ci"],
      "properties": {
        "lease": {
          "type": "object",
          "additionalProperties": false,
          "required": ["state", "lease_id", "generation", "branch"],
          "properties": {
            "state": {"enum": ["NONE", "ACTIVE", "RELEASED", "EXPIRED", "UNKNOWN"]},
            "lease_id": {"type": ["string", "null"], "minLength": 1, "maxLength": 128},
            "generation": {"type": ["integer", "null"], "minimum": 0},
            "branch": {"type": ["string", "null"], "maxLength": 256}
          }
        },
        "branch": {
          "type": "object",
          "additionalProperties": false,
          "required": ["present", "name", "head_sha"],
          "properties": {
            "present": {"type": "boolean"},
            "name": {"type": ["string", "null"], "maxLength": 256},
            "head_sha": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/sha40"}]}
          }
        },
        "pull_request": {
          "type": "object",
          "additionalProperties": false,
          "required": ["state", "number", "base_sha", "head_sha", "merge_commit_sha"],
          "properties": {
            "state": {"enum": ["NONE", "OPEN", "MERGED", "CLOSED", "UNKNOWN"]},
            "number": {"type": ["integer", "null"], "minimum": 1},
            "base_sha": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/sha40"}]},
            "head_sha": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/sha40"}]},
            "merge_commit_sha": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/sha40"}]}
          }
        },
        "ci": {
          "type": "object",
          "additionalProperties": false,
          "required": ["state", "head_sha"],
          "properties": {
            "state": {"enum": ["NONE", "SUCCESS", "PENDING", "FAILED", "AMBIGUOUS", "UNKNOWN"]},
            "head_sha": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/sha40"}]}
          }
        }
      }
    },
    "last_completed_steady_state_iteration": {"type": "integer", "minimum": 0},
    "transaction_boundary": {"enum": ["CLEAN_ITERATION_BOUNDARY", "TRANSACTION_OUTCOME_UNKNOWN", "PROVIDER_READBACK_PENDING"]},
    "persisted_decisions": {
      "type": "object",
      "additionalProperties": false,
      "required": ["control_loop_decision", "execution_admission_decision", "ci_decision"],
      "properties": {
        "control_loop_decision": {"type": ["string", "null"], "maxLength": 128},
        "execution_admission_decision": {"type": ["string", "null"], "maxLength": 128},
        "ci_decision": {"type": ["string", "null"], "maxLength": 128}
      }
    },
    "checkpoint_is_mutation_authority": {"const": false},
    "checkpoint_cas_tokens_reusable": {"const": false},
    "checkpoint_ci_success_reusable": {"const": false},
    "checkpoint_admission_reusable": {"const": false},
    "contains_private_runtime_payload": {"const": false},
    "contains_credentials": {"const": false},
    "contains_host_identifiers": {"const": false},
    "contains_secret_transport_data": {"const": false}
  },
  "$defs": {
    "sha40": {"type": "string", "pattern": "^[0-9a-f]{40}$"}
  }
}
