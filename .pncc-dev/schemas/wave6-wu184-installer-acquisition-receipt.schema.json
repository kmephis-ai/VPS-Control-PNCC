{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "pncc://wave6/wu184/installer-acquisition-receipt",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "receipt_type", "policy_source", "toolchain", "artifact", "source", "github_release_attestation", "authenticode", "acquisition", "verification"],
  "properties": {
    "schema_version": {"const": 1},
    "receipt_type": {"const": "PNCC_INSTALLER_COMPILER_ACQUISITION"},
    "policy_source": {"const": "PIPE-WU-184"},
    "toolchain": {
      "type": "object", "additionalProperties": false,
      "required": ["family", "version", "edition", "upstream_repository", "immutable_release_tag", "release_id", "asset_id", "asset_filename"],
      "properties": {
        "family": {"const": "Inno Setup"}, "version": {"const": "7.1.0"}, "edition": {"const": "x64"},
        "upstream_repository": {"const": "jrsoftware/issrc"}, "immutable_release_tag": {"const": "is-7_1_0"},
        "release_id": {"const": 369110765}, "asset_id": {"const": 511336600},
        "asset_filename": {"const": "innosetup-7.1.0-x64.exe"}
      }
    },
    "artifact": {
      "type": "object", "additionalProperties": false,
      "required": ["sha256", "byte_count"],
      "properties": {
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "byte_count": {"type": "integer", "minimum": 1}
      }
    },
    "source": {
      "type": "object", "additionalProperties": false,
      "required": ["url", "mutable_latest", "mirror_trust_anchor", "package_manager_sole_trust"],
      "properties": {
        "url": {"const": "https://github.com/jrsoftware/issrc/releases/download/is-7_1_0/innosetup-7.1.0-x64.exe"},
        "mutable_latest": {"const": false}, "mirror_trust_anchor": {"const": false}, "package_manager_sole_trust": {"const": false}
      }
    },
    "github_release_attestation": {
      "type": "object", "additionalProperties": false,
      "required": ["verified", "repository", "verifier"],
      "properties": {"verified": {"const": true}, "repository": {"const": "jrsoftware/issrc"}, "verifier": {"const": "gh release verify-asset"}}
    },
    "authenticode": {
      "type": "object", "additionalProperties": false,
      "required": ["verified", "publisher"],
      "properties": {"verified": {"const": true}, "publisher": {"const": "Pyrsys B.V."}}
    },
    "acquisition": {
      "type": "object", "additionalProperties": false,
      "required": ["runner_provider", "runner_os", "runner_image", "acquired_at_utc"],
      "properties": {
        "runner_provider": {"const": "github-hosted"}, "runner_os": {"const": "Windows"},
        "runner_image": {"type": "string", "minLength": 1},
        "acquired_at_utc": {"type": "string", "pattern": "^20[0-9]{2}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"}
      }
    },
    "verification": {
      "type": "object", "additionalProperties": false,
      "required": ["status", "fail_closed"],
      "properties": {"status": {"const": "VERIFIED"}, "fail_closed": {"const": true}}
    }
  }
}
