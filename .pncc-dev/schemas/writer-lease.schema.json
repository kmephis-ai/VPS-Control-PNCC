{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "PNCC Writer Lease Contract v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "role", "lease_id", "work_unit_id", "conflict_domain", "holder", "base_sha", "branch", "state", "generation", "acquired_at", "heartbeat_at", "expires_at"],
  "properties": {
    "schema_version": {"const": 1},
    "role": {"const": "WRITER_LEASE"},
    "lease_id": {"type": "string", "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-5][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"},
    "work_unit_id": {"type": "string", "pattern": "^[A-Z][A-Z0-9_-]*-[0-9]+$"},
    "conflict_domain": {"type": "string", "minLength": 1},
    "holder": {"type": "string", "minLength": 1},
    "base_sha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "branch": {"type": "string", "minLength": 1},
    "state": {"enum": ["ACTIVE", "RELEASED", "EXPIRED"]},
    "generation": {"type": "integer", "minimum": 1},
    "acquired_at": {"type": "string", "minLength": 1},
    "heartbeat_at": {"type": "string", "minLength": 1},
    "expires_at": {"type": "string", "minLength": 1}
  }
}
