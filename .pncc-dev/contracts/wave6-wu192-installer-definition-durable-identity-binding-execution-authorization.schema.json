{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/kmephis-ai/VPS-Control-PNCC/.pncc-dev/contracts/wave6-wu192-installer-definition-durable-identity-binding-execution-authorization.schema.json",
  "title": "PNCC WU192 installer-definition durable identity-binding execution authorization readiness receipt",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "work_unit_id",
    "source_transaction_work_unit",
    "decision",
    "reasons",
    "proposal_sha256",
    "proposal_byte_count",
    "binding_request_sha256",
    "transaction_intent_sha256",
    "target_path",
    "execution_authorization_request_sha256",
    "exact_transaction_lineage_match",
    "target_metadata_safe",
    "verified",
    "durable_identity_bound",
    "proposal_materialized",
    "binding_receipt_persisted",
    "write_authorized",
    "compiler_execution_authorized",
    "build_authorized"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "work_unit_id": {"const": "PIPE-WU-192"},
    "source_transaction_work_unit": {"const": "PIPE-WU-191"},
    "decision": {"enum": ["EXECUTION_AUTHORIZATION_READY_ONLY", "BLOCKED"]},
    "reasons": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
    "proposal_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "proposal_byte_count": {"type": "integer", "minimum": 0},
    "binding_request_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "transaction_intent_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "target_path": {"type": "string"},
    "execution_authorization_request_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "exact_transaction_lineage_match": {"type": "boolean"},
    "target_metadata_safe": {"type": "boolean"},
    "verified": {"const": false},
    "durable_identity_bound": {"const": false},
    "proposal_materialized": {"const": false},
    "binding_receipt_persisted": {"const": false},
    "write_authorized": {"const": false},
    "compiler_execution_authorized": {"const": false},
    "build_authorized": {"const": false}
  }
}
