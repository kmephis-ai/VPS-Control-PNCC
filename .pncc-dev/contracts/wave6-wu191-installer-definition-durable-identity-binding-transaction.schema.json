{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/kmephis-ai/VPS-Control-PNCC/.pncc-dev/contracts/wave6-wu191-installer-definition-durable-identity-binding-transaction.schema.json",
  "title": "PNCC WU191 installer-definition durable identity-binding transaction readiness receipt",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "work_unit_id",
    "source_binding_request_work_unit",
    "decision",
    "reasons",
    "proposal_sha256",
    "proposal_byte_count",
    "binding_request_sha256",
    "transaction_intent_sha256",
    "exact_request_lineage_match",
    "verified",
    "durable_identity_bound",
    "proposal_materialized",
    "binding_receipt_persisted",
    "compiler_execution_authorized",
    "build_authorized"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "work_unit_id": {"const": "PIPE-WU-191"},
    "source_binding_request_work_unit": {"const": "PIPE-WU-190"},
    "decision": {"enum": ["TRANSACTION_READY_ONLY", "BLOCKED"]},
    "reasons": {
      "type": "array",
      "items": {"type": "string", "minLength": 1},
      "uniqueItems": true
    },
    "proposal_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "proposal_byte_count": {"type": "integer", "minimum": 0},
    "binding_request_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "transaction_intent_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "exact_request_lineage_match": {"type": "boolean"},
    "verified": {"const": false},
    "durable_identity_bound": {"const": false},
    "proposal_materialized": {"const": false},
    "binding_receipt_persisted": {"const": false},
    "compiler_execution_authorized": {"const": false},
    "build_authorized": {"const": false}
  }
}
