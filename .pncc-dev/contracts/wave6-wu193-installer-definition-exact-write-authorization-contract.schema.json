{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/kmephis-ai/VPS-Control-PNCC/.pncc-dev/contracts/wave6-wu193-installer-definition-exact-write-authorization-contract.schema.json",
  "title": "PNCC WU193 installer-definition exact write-authorization contract readiness receipt",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "work_unit_id", "source_execution_authorization_work_unit",
    "decision", "reasons", "repository", "base_sha", "target_branch", "target_path",
    "proposal_sha256", "proposal_byte_count", "execution_authorization_request_sha256",
    "expected_prewrite_state", "expected_prewrite_blob_sha", "authorization_id",
    "write_authorization_contract_sha256", "exact_execution_lineage_match",
    "target_metadata_safe", "prewrite_expectation_valid", "owner_authorization_state",
    "verified", "durable_identity_bound", "proposal_materialized",
    "binding_receipt_persisted", "write_authorized", "compiler_execution_authorized",
    "build_authorized"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "work_unit_id": {"const": "PIPE-WU-193"},
    "source_execution_authorization_work_unit": {"const": "PIPE-WU-192"},
    "decision": {"enum": ["WRITE_AUTHORIZATION_CONTRACT_READY_ONLY", "BLOCKED"]},
    "reasons": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
    "repository": {"const": "kmephis-ai/VPS-Control-PNCC"},
    "base_sha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "target_branch": {"type": "string", "minLength": 1, "maxLength": 200},
    "target_path": {"type": "string", "maxLength": 240},
    "proposal_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "proposal_byte_count": {"type": "integer", "minimum": 0},
    "execution_authorization_request_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "expected_prewrite_state": {"enum": ["ABSENT", "EXACT_BLOB", ""]},
    "expected_prewrite_blob_sha": {"type": "string", "pattern": "^(|[0-9a-f]{40})$"},
    "authorization_id": {"type": "string", "maxLength": 128},
    "write_authorization_contract_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "exact_execution_lineage_match": {"type": "boolean"},
    "target_metadata_safe": {"type": "boolean"},
    "prewrite_expectation_valid": {"type": "boolean"},
    "owner_authorization_state": {"const": "NOT_GRANTED"},
    "verified": {"const": false},
    "durable_identity_bound": {"const": false},
    "proposal_materialized": {"const": false},
    "binding_receipt_persisted": {"const": false},
    "write_authorized": {"const": false},
    "compiler_execution_authorized": {"const": false},
    "build_authorized": {"const": false}
  }
}
