{
  "schema_version": 1,
  "role": "DURABLE_AUTONOMOUS_CONTINUATION_MULTI_SESSION_STEADY_STATE_POLICY",
  "policy_state": "ACTIVE_WHEN_CANONICAL_AND_ALL_ANCHORS_MATCH",
  "mode": "PLAN_ONLY_MULTI_SESSION_FAIL_CLOSED",
  "repository": "kmephis-ai/VPS-Control-PNCC",
  "default_branch": "main",
  "session_role": "DURABLE_AUTONOMOUS_CONTINUATION_SESSION",
  "handoff_record_role": "DURABLE_AUTONOMOUS_CONTINUATION_MULTI_SESSION_HANDOFF_RECORD",
  "snapshot_role": "DURABLE_AUTONOMOUS_CONTINUATION_MULTI_SESSION_SNAPSHOT",
  "decision_role": "DURABLE_AUTONOMOUS_CONTINUATION_MULTI_SESSION_DECISION",
  "fresh_provider_truth_required_at_every_session_start": true,
  "fresh_current_main_required_at_every_session_start": true,
  "fresh_selected_work_unit_required_at_every_session_start": true,
  "fresh_provider_state_required_at_every_session_start": true,
  "fresh_branch_pr_ci_truth_required_when_applicable": true,
  "fresh_wu108_recomputation_required_before_every_session_mutation": true,
  "fresh_wu109_recomputation_required_before_every_session_mutation": true,
  "one_delegated_provider_transaction_per_iteration": true,
  "mandatory_provider_readback_after_every_delegated_transaction": true,
  "next_iteration_requires_previous_readback": true,
  "checkpoint_refresh_requires_clean_iteration_boundary": true,
  "checkpoint_refresh_requires_fresh_provider_readback": true,
  "checkpoint_refresh_is_hint_only": true,
  "checkpoint_refresh_never_grants_mutation_authority": true,
  "prior_checkpoint_is_immutable_history": true,
  "prior_checkpoint_authority_reuse_forbidden": true,
  "prior_control_loop_decision_reuse_forbidden": true,
  "prior_execution_admission_reuse_forbidden": true,
  "prior_ci_success_reuse_forbidden": true,
  "prior_registry_cas_reuse_forbidden": true,
  "prior_merge_eligibility_reuse_forbidden": true,
  "prior_writer_lease_ownership_reuse_forbidden": true,
  "provider_truth_supersedes_all_persisted_session_state": true,
  "interrupted_session_requires_provider_reconciliation_before_mutation": true,
  "readback_pending_session_requires_provider_readback_before_mutation": true,
  "unknown_transaction_outcome_replay_forbidden": true,
  "classified_failure_requires_separate_authority": true,
  "session_target_inheritance_forbidden": true,
  "session_sequence_must_increase_by_one": true,
  "checkpoint_identity_must_change_on_refresh": true,
  "maximum_retained_historical_checkpoint_identities": 8,
  "retention_payload_policy": "IDENTITIES_AND_PUBLIC_SAFE_PROVIDER_REFERENCES_ONLY",
  "session_start_decisions": [
    "START_FRESH_RECOMPUTE",
    "RECONCILE_INTERRUPTED_SESSION",
    "WAIT_FOR_PROVIDER_READBACK",
    "SEPARATE_AUTHORITY_REQUIRED",
    "BLOCKED"
  ],
  "iteration_decisions": [
    "ADMIT_FRESH_ITERATION",
    "REQUIRE_PROVIDER_READBACK",
    "CLEAN_HANDOFF_READY",
    "SEPARATE_AUTHORITY_REQUIRED",
    "BLOCKED"
  ],
  "handoff_classes": [
    "CLEAN_ITERATION_BOUNDARY",
    "TRANSACTION_OUTCOME_UNKNOWN",
    "PROVIDER_READBACK_PENDING"
  ],
  "clean_session_transition": {
    "required_previous_handoff_class": "CLEAN_ITERATION_BOUNDARY",
    "fresh_provider_truth_must_be_read": true,
    "persisted_decisions_must_be_discarded": true,
    "fresh_wu108_wu109_must_be_recomputed_before_mutation": true,
    "new_session_target_must_equal_fresh_selected_work_unit": true
  },
  "interrupted_session_transition": {
    "required_previous_handoff_class": "TRANSACTION_OUTCOME_UNKNOWN",
    "provider_reconciliation_required": true,
    "delegated_transaction_replay_forbidden": true,
    "new_mutation_before_reconciliation_forbidden": true
  },
  "readback_pending_session_transition": {
    "required_previous_handoff_class": "PROVIDER_READBACK_PENDING",
    "provider_readback_required": true,
    "delegated_transaction_replay_forbidden": true,
    "new_mutation_before_readback_forbidden": true
  },
  "checkpoint_refresh_contract": {
    "new_checkpoint_sequence_equals_completed_session_sequence": true,
    "new_checkpoint_must_bind_fresh_main": true,
    "new_checkpoint_must_bind_fresh_selected_work_unit": true,
    "new_checkpoint_must_bind_fresh_provider_state": true,
    "new_checkpoint_must_bind_fresh_branch_pr_ci_when_applicable": true,
    "new_checkpoint_must_record_clean_or_reconcilable_boundary": true,
    "new_checkpoint_must_mark_all_authority_reuse_false": true,
    "prior_checkpoint_content_must_not_be_mutated": true
  },
  "public_safety_required": true,
  "forbidden_checkpoint_payload_classes": [
    "credentials",
    "dpapi_material",
    "tokens",
    "private_runtime_payload",
    "raw_runtime_logs",
    "host_identifiers",
    "local_private_paths",
    "secret_transport_data",
    "external_ip_addresses"
  ],
